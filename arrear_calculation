"""Standalone Rajasthan salary-arrear calculation engine.

The UI in app.py only collects inputs and calls calculate_arrear().
All arrear calculations live in this module so the other application modules
remain independent.
"""
from __future__ import annotations

import calendar
from datetime import date
from typing import Callable, Iterable, Optional

